{
  "info": {
    "name": "File Service API",
    "description": "Centralized file management built on FastAPI + AWS S3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api/v1" },
    { "key": "api_key",  "value": "8fba5786e29e98315decdb1eed0dca80" },
    { "key": "file_uuid", "value": "" },
    { "key": "upload_url", "value": "" }
  ],
  "item": [
    {
      "name": "1. Request Upload URL",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-api-key",    "value": "{{api_key}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"filename\": \"demo-report.pdf\",\n  \"content_type\": \"application/pdf\",\n  \"owner_id\": \"cto_demo\"\n}"
        },
        "url": { "raw": "{{base_url}}/files/upload-url", "host": ["{{base_url}}"], "path": ["files", "upload-url"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "pm.collectionVariables.set('file_uuid', json.data.file_uuid);",
              "pm.collectionVariables.set('upload_url', json.data.upload_url);",
              "pm.test('Got presigned URL', () => pm.expect(json.data.upload_url).to.include('s3.amazonaws.com'));",
              "pm.test('Got file_uuid', () => pm.expect(json.data.file_uuid).to.be.a('string'));",
              "console.log('Saved file_uuid:', json.data.file_uuid);",
              "console.log('Saved upload_url:', json.data.upload_url);"
            ]
          }
        }
      ]
    },
    {
      "name": "1b. Upload Binary to S3 (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/pdf" }
        ],
        "body": {
          "mode": "raw",
          "raw": "%PDF-1.4 ... Sample PDF binary content for testing presigned upload ..."
        },
        "url": { "raw": "{{upload_url}}" },
        "description": "Uploads raw file binary directly to AWS S3 using the presigned PUT URL generated in Step 1. Note: This HTTP PUT request goes directly to AWS S3, NOT through the FastAPI File Service API."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('S3 Upload Status 200', () => pm.expect(pm.response.code).to.equal(200));",
              "console.log('Uploaded binary directly to AWS S3 successfully');"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Confirm Upload",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-api-key", "value": "{{api_key}}" }
        ],
        "url": { "raw": "{{base_url}}/files/{{file_uuid}}/confirm", "host": ["{{base_url}}"], "path": ["files", "{{file_uuid}}", "confirm"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 or 400', () => pm.expect(pm.response.code).to.be.oneOf([200, 400]));",
              "console.log('Confirm response:', pm.response.json());"
            ]
          }
        }
      ]
    },
    {
      "name": "3. List Files",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-api-key", "value": "{{api_key}}" }
        ],
        "url": {
          "raw": "{{base_url}}/files?status=ALL&page=1&page_size=20",
          "host": ["{{base_url}}"],
          "path": ["files"],
          "query": [
            { "key": "status", "value": "ALL" },
            { "key": "page",  "value": "1" },
            { "key": "page_size", "value": "20" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "var json = pm.response.json();",
              "pm.test('Has items field', () => pm.expect(json.data).to.have.property('items'));",
              "console.log('Total files:', json.data.total);"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Get File Metadata",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-api-key", "value": "{{api_key}}" }
        ],
        "url": { "raw": "{{base_url}}/files/{{file_uuid}}", "host": ["{{base_url}}"], "path": ["files", "{{file_uuid}}"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "console.log('Metadata:', pm.response.json());"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Get Download URL",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-api-key", "value": "{{api_key}}" }
        ],
        "url": {
          "raw": "{{base_url}}/files/{{file_uuid}}/download-url?expires_in=300",
          "host": ["{{base_url}}"],
          "path": ["files", "{{file_uuid}}", "download-url"],
          "query": [{ "key": "expires_in", "value": "300" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 or 400', () => pm.expect(pm.response.code).to.be.oneOf([200, 400]));",
              "console.log('Download response:', pm.response.json());"
            ]
          }
        }
      ]
    },
    {
      "name": "5b. Permanent File Content Permalink (307 Redirect)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/files/{{file_uuid}}/content?api_key={{api_key}}",
          "host": ["{{base_url}}"],
          "path": ["files", "{{file_uuid}}", "content"],
          "query": [{ "key": "api_key", "value": "{{api_key}}" }]
        },
        "description": "Permanent non-expiring file link. Consuming apps store this URL pattern in their DBs. Accepts api_key as query param or x-api-key as header, and returns a 307 redirect to S3."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 307 Redirect or 200', () => pm.expect(pm.response.code).to.be.oneOf([307, 200]));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Delete File",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "x-api-key", "value": "{{api_key}}" }
        ],
        "url": { "raw": "{{base_url}}/files/{{file_uuid}}", "host": ["{{base_url}}"], "path": ["files", "{{file_uuid}}"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Deleted', () => pm.expect(pm.response.json().success).to.equal(true));",
              "console.log('Deleted file_uuid:', pm.response.json().data.file_uuid);"
            ]
          }
        }
      ]
    },
    {
      "name": "AUTH TEST - Invalid Key (expect 401)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-api-key", "value": "wrong_key_here" }
        ],
        "url": { "raw": "{{base_url}}/files/upload-url", "host": ["{{base_url}}"], "path": ["files", "upload-url"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Rejects invalid key with 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}
