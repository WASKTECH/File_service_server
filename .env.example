# ──────────────────────────────────────────────────
# Environment variables for the File Service API.
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
S3_BUCKET=your_s3_bucket_name

# Database
# For local dev with SQLite:   sqlite:///./file_server.db
# For PostgreSQL (production): postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://fileapi:devpassword123@localhost:5432/filedb

# Docker Compose PostgreSQL (used by docker-compose.yml)
POSTGRES_USER=fileapi
POSTGRES_PASSWORD=devpassword123
POSTGRES_DB=filedb
